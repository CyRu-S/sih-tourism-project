# Supabase transaction-pooler example. Keep the real .env local and untracked.
DB_URL=jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Optional: enables OpenRouteService geometry. Without it, the API returns a straight-line route fallback.
ORS_API_KEY=
